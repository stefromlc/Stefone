        "name": "Garlic paste (divided)"
      },
      {
        "amount": "2",
        "unit": "tsp",
        "name": "Ginger paste (divided)"
      },
      {
        "amount": "",
        "unit": "",
        "name": "Salt and pepper, to taste"
      },
      {
        "amount": "2",
        "unit": "cups",
        "name": "Kellogg's Frosties, crushed (not powdered)"
      },
      {
        "amount": "1",
        "unit": "",
        "name": "Egg, beaten"
      },
      {
        "amount": "2",
        "unit": "tbsp",
        "name": "Milk (for egg wash)"
      },
      {
        "amount": "1",
        "unit": "tsp",
        "name": "Sesame oil"
      },
      {
        "amount": "2",
        "unit": "",
        "name": "Brioche buns, toasted"
      },
      {
        "amount": "",
        "unit": "",
        "name": "Sriracha mayo"
      },
      {
        "amount": "",
        "unit": "",
