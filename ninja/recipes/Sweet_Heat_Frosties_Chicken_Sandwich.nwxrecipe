        "name": "Pickled jalape\u00f1os (optional)"
      }
    ],
    "steps": [
      {
        "text": "Combine milk and lemon juice and leave for 3 minutes to create a quick buttermilk substitute."
      },
      {
        "text": "Mix in soy sauce, 1 tbsp honey, 1 tbsp sriracha, 1 tsp garlic paste, 1 tsp ginger paste, salt and pepper. Marinate the chicken for 1 to 2 hours."
      },
      {
        "text": "Crush the Frosties into small crunchy pieces and place in a shallow dish."
      },
      {
        "text": "Whisk the egg with 2 tbsp milk. Dip marinated chicken into the egg mixture then coat firmly with the crushed Frosties."
      },
      {
        "text": "Preheat the air fryer or Ninja Woodfire Grill Air Fry function to 180\u00b0C. Lightly oil the basket and cook for 12 minutes, flipping halfway, until the chicken reaches 75\u00b0C."
      },
      {
        "text": "Meanwhile heat 5 tbsp honey, 2 tbsp soy sauce, 1 tbsp sriracha, 1 tsp garlic paste, 1 tsp ginger paste and sesame oil until thickened, about 3 to 4 minutes."
      },
      {
        "text": "Brush the cooked chicken generously with the warm glaze."
      },
      {
        "text": "Spread sriracha mayo on toasted brioche buns, add lettuce or slaw, top with glazed chicken, sprinkle with extra crushed Frosties, add pickled jalape\u00f1os if desired and serve immediately."
      }
    ],
    "ninjaSettings": {
      "function": "Air Fry",
      "woodfireFlavor": false,
