        "unit": "cups",
        "name": "Kellogg's Frosties, crushed"
      },
      {
        "amount": "1",
        "unit": "",
        "name": "Egg, beaten"
      },
      {
        "amount": "2",
        "unit": "tbsp",
        "name": "Milk (for egg wash)"
      },
      {
