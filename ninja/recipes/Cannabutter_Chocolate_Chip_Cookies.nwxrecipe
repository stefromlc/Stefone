"recipe": {
"id": "id-5a9ec0a3eb9440671",
"title": "Cannabutter Chocolate Chip Cookies",
"description": "The ultimate guide to making infused chocolate chip cookies, starting from raw cannabis flower. This comprehensive recipe walks you through safely decarboxylating your flower, infusing a rich butter base, and baking soft, chewy, perfectly elevated cookies with gooey chocolate centers.",
"heroImage": "https://images.unsplash.com/photo-1499636136210-6f4ee915583e?auto=format&fit=crop&w=1200&q=80](https://www.google.com/search?q=https://images.unsplash.com/photo-1499636136210-6f4ee915583e%3Fauto%3Dformat%26fit%3Dcrop%26w%3D1200%26q%3D80",
"category": "Cookies",
"difficulty": "Advanced",
"servings": 12,
"tags": [
