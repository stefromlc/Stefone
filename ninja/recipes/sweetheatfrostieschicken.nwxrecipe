    "steps": [
      {
        "text": "Combine the milk and lemon juice and leave for 3 minutes to create a quick buttermilk substitute."
      },
      {
        "text": "Mix in the soy sauce, honey, sriracha, garlic paste, ginger paste, salt and pepper."
      },
      {
        "text": "Coat the chicken breasts in the marinade and refrigerate for 1 to 2 hours."
      },
      {
        "text": "Crush the Frosties into small crunchy pieces and place in a shallow dish."
      },
      {
        "text": "Whisk together the egg and milk in a second shallow dish."
      },
      {
        "text": "Remove the chicken from the marinade, dip into the egg mixture, then firmly coat with the crushed Frosties."
      },
      {
        "text": "Preheat the Ninja Woodfire Grill or Air Fryer to 180°C. Lightly oil the basket or crisper plate."
      },
      {
        "text": "Cook the chicken for 12 minutes, turning halfway through, until golden and the internal temperature reaches 75°C."
      },
      {
        "text": "Meanwhile, combine the honey, soy sauce, sriracha, garlic paste, ginger paste and sesame oil in a saucepan. Simmer for 3 to 4 minutes until thickened."
      },
      {
        "text": "Brush the cooked chicken generously with the warm glaze."
      },
      {
        "text": "Spread sriracha mayo over the toasted brioche buns, add lettuce or slaw, top with the glazed chicken, sprinkle over a few extra crushed Frosties and finish with pickled jalapeños if desired."
      },
      {
        "text": "Serve immediately while hot and crispy."
      }
    ],
